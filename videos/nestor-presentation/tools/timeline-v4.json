   "vo": "vo-006",
   "vo_start": 32.2,
   "vo_end": 36.55,
   "master": "/data/loic/Bercy-Hub-Loic/projects/nestor-voix/film/v4/vo-006-nestor.wav",
   "text": "Un numéro de téléphone dans votre texte, je vous préviens. Avant tout envoi."
