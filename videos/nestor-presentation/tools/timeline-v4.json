   "vo_end": 11.12,
   "master": "/data/loic/Bercy-Hub-Loic/projects/nestor-voix/film/v4/vo-002-nestor.wav",
   "text": "Voici Nestor. Je suis là, à droite. Je vous apprends à bien demander, en travaillant."
