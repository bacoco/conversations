   "duration": 7.6,
   "vo": "vo-007",
   "vo_start": 37.2,
   "vo_end": 43.46,
   "master": "/data/loic/Bercy-Hub-Loic/projects/nestor-voix/film/v4/vo-007-nestor.wav",
   "text": "La réponse arrive. Je la relis avec vous. S'il manque l'essentiel, je vous le signale. Et je vous dis quoi faire."
