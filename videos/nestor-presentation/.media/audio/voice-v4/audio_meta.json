[
 {
  "id": "vo-001",
  "speaker": "Nestor",
  "scene": "v4-01-dossier",
  "text": "Vous connaissez votre dossier. Votre IA, elle, ne le connaît pas. Alors elle devine.",
  "voice": "nestor-aventuriere",
  "language": "fr",
  "speed": 1.0,
  "path": ".media/audio/voice-v4/vo-001-nestor.mp3",
  "duration_s": 4.84,
  "sha256": "01bce2c87b6045ca74012e465a2e4a6a4dfbf5ea1b6f3c38efdd08e73f3959d2",
  "master": "/data/loic/Bercy-Hub-Loic/projects/nestor-voix/film/v4/vo-001-nestor.wav"
 },
 {
  "id": "vo-002",
  "speaker": "Nestor",
  "scene": "v4-02-nestor",
  "text": "Voici Nestor. Je suis là, à droite. Je vous apprends à bien demander, en travaillant.",
  "voice": "nestor-aventuriere",
  "language": "fr",
  "speed": 1.0,
  "path": ".media/audio/voice-v4/vo-002-nestor.mp3",
  "duration_s": 4.77,
  "sha256": "bfc6043873849ac90f565ad5bb411a8c1edb23fd56483a6837ae887c9e883bc0",
  "master": "/data/loic/Bercy-Hub-Loic/projects/nestor-voix/film/v4/vo-002-nestor.wav"
 },
 {
  "id": "vo-003",
  "speaker": "Nestor",
  "scene": "v4-03-pistes",
  "text": "Pendant que vous écrivez, je vous propose des débuts plus précis. Un clic, et la piste est dans votre champ.",
  "voice": "nestor-aventuriere",
  "language": "fr",
  "speed": 1.0,
  "path": ".media/audio/voice-v4/vo-003-nestor.mp3",
  "duration_s": 6.05,
  "sha256": "7b1d6b88e97972360e3e3b7a71c7e3c3e5a4d3d0626fe9c56d5ab5c826da09db",
  "master": "/data/loic/Bercy-Hub-Loic/projects/nestor-voix/film/v4/vo-003-nestor.wav"
 },
 {
  "id": "vo-004",
  "speaker": "Nestor",
  "scene": "v4-04-manque",
  "text": "Je vous montre ce qui manque. Vous complétez. Vous seul connaissez votre dossier.",
  "voice": "nestor-aventuriere",
  "language": "fr",
  "speed": 1.0,
  "path": ".media/audio/voice-v4/vo-004-nestor.mp3",
  "duration_s": 4.76,
  "sha256": "ea2a662477370602242244264158dfa8efa39ca53a06bf322b77b37f4946964a",
  "master": "/data/loic/Bercy-Hub-Loic/projects/nestor-voix/film/v4/vo-004-nestor.wav"
 },
 {
  "id": "vo-005",
  "speaker": "Nestor",
  "scene": "v4-05-conseils",
  "text": "D'abord, des conseils. Vous choisissez ce que vous gardez. Ensuite, le bon texte, avec vos références.",
  "voice": "nestor-aventuriere",
  "language": "fr",
  "speed": 1.0,
  "path": ".media/audio/voice-v4/vo-005-nestor.mp3",
  "duration_s": 5.83,
  "sha256": "215b81e2fb503c4821b6aca3d5aa43fe837084390eaaef799aa649c215272ed3",
  "master": "/data/loic/Bercy-Hub-Loic/projects/nestor-voix/film/v4/vo-005-nestor.wav"
 },
 {
  "id": "vo-006",
  "speaker": "Nestor",
  "scene": "v4-06-donnees",
  "text": "Un numéro de téléphone dans votre texte, je vous préviens. Avant tout envoi.",
  "voice": "nestor-aventuriere",
  "language": "fr",
  "speed": 1.0,
  "path": ".media/audio/voice-v4/vo-006-nestor.mp3",
  "duration_s": 4.35,
  "sha256": "1a80698e3f8b33bb54156b446ef5655ba091a789fb503cd9ac73d886bc76ac26",
  "master": "/data/loic/Bercy-Hub-Loic/projects/nestor-voix/film/v4/vo-006-nestor.wav"
 },
 {
  "id": "vo-007",
  "speaker": "Nestor",
  "scene": "v4-07-verifier",
  "text": "La réponse arrive. Je la relis avec vous. S'il manque l'essentiel, je vous le signale. Et je vous dis quoi faire.",
  "voice": "nestor-aventuriere",
  "language": "fr",
  "speed": 1.0,
  "path": ".media/audio/voice-v4/vo-007-nestor.mp3",
  "duration_s": 6.26,
  "sha256": "c391defa46115d407148576b47cf5b8ed7c0097524e13a02e5129be5b8ea3573",
  "master": "/data/loic/Bercy-Hub-Loic/projects/nestor-voix/film/v4/vo-007-nestor.wav"
 },
 {
  "id": "vo-008",
  "speaker": "Nestor",
  "scene": "v4-08-boutons",
  "text": "Mes quatre boutons restent à portée de main. Vous pouvez aussi me parler, à voix haute.",
  "voice": "nestor-aventuriere",
  "language": "fr",
  "speed": 1.0,
  "path": ".media/audio/voice-v4/vo-008-nestor.mp3",
  "duration_s": 4.66,
  "sha256": "66a18e00602b7433a3d87943c67615896f896b50341250e76a2f3844beab4bd7",
  "master": "/data/loic/Bercy-Hub-Loic/projects/nestor-voix/film/v4/vo-008-nestor.wav"
 },
 {
  "id": "vo-009",
  "speaker": "Nestor",
  "scene": "v4-09-progresser",
  "text": "Et chaque semaine, vous progressez.",
  "voice": "nestor-aventuriere",
  "language": "fr",
  "speed": 1.0,
  "path": ".media/audio/voice-v4/vo-009-nestor.mp3",
  "duration_s": 2.14,
  "sha256": "8005ea985017322a0c8bb2c26a94f59c9239142f993d3f06096e8d87796cd42c",
  "master": "/data/loic/Bercy-Hub-Loic/projects/nestor-voix/film/v4/vo-009-nestor.wav"
 },
 {
  "id": "vo-010",
  "speaker": "Nestor",
  "scene": "v4-10-cas",
  "text": "De vrais cas de votre métier. Dix métiers, trois niveaux. Je vous guide, pas à pas.",
  "voice": "nestor-aventuriere",
  "language": "fr",
  "speed": 1.0,
  "path": ".media/audio/voice-v4/vo-010-nestor.mp3",
  "duration_s": 4.64,
  "sha256": "0165ee896453790e7f202625482dc4118f1dd2d9b7a875523d923ce5666b1b85",
  "master": "/data/loic/Bercy-Hub-Loic/projects/nestor-voix/film/v4/vo-010-nestor.wav"
 },
 {
  "id": "vo-011",
  "speaker": "Nestor",
  "scene": "v4-11-semaine",
  "text": "Vingt minutes par semaine, dans votre agenda. Des badges, une attestation à imprimer. Vos progrès restent sur votre poste. Personne ne vous classe.",
  "voice": "nestor-aventuriere",
  "language": "fr",
  "speed": 1.0,
  "path": ".media/audio/voice-v4/vo-011-nestor.mp3",
  "duration_s": 8.35,
  "sha256": "e1edb5e10ef308ee0c23b56dd5bdf6404c1c869d8de8234ae82d692f7eae2460",
  "master": "/data/loic/Bercy-Hub-Loic/projects/nestor-voix/film/v4/vo-011-nestor.wav"
 },
 {
  "id": "vo-012",
  "speaker": "Nestor",
  "scene": "v4-12-aussi",
  "text": "Et aussi, huit leçons courtes. Et des outils pour chaque jour, avec des demandes prêtes en un clic.",
  "voice": "nestor-aventuriere",
  "language": "fr",
  "speed": 1.0,
  "path": ".media/audio/voice-v4/vo-012-nestor.mp3",
  "duration_s": 5.62,
  "sha256": "e7408ff146915e5d81593eced79ae207570a84cd1ae403ec74221ff6c68039e0",
  "master": "/data/loic/Bercy-Hub-Loic/projects/nestor-voix/film/v4/vo-012-nestor.wav"
 },
 {
  "id": "vo-013",
  "speaker": "Nestor",
  "scene": "v4-13-fin",
  "text": "Je m'appuie sur Albert, l'IA de l'État. Écrivez votre demande, puis cliquez sur Analyser mon texte. Je suis à droite, avec vous.",
  "voice": "nestor-aventuriere",
  "language": "fr",
  "speed": 1.0,
  "path": ".media/audio/voice-v4/vo-013-nestor.mp3",
