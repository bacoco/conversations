[
  {
    "id": "vo-001-nestor",
    "step": "hello",
    "speaker": "nestor",
    "text": "Bonjour ! Voici Nestor, votre coach. En quelques minutes, je vous montre comment je vous aide à bien écrire à l'assistant. Tout se passe ici, dans le panneau de droite.",
    "voice": "nestor-aventuriere",
    "language": "fr",
    "speed": 1.0,
    "path": ".media/audio/voice/vo-001-nestor.wav",
    "duration_s": 9.39,
    "sha256": "9d709078d81610e4d685ebae96ffc0162ade92a93241e735d5da6ad2af3d55d8"
  },
  {
    "id": "vo-002-nestor",
    "step": "home-coach",
    "speaker": "nestor",
    "text": "« Coach » : c'est moi. Je regarde votre demande avant que vous l'envoyiez, je vous donne des conseils, puis je vérifie avec vous la réponse de l'assistant.",
    "voice": "nestor-aventuriere",
    "language": "fr",
    "speed": 1.0,
    "path": ".media/audio/voice/vo-002-nestor.wav",
    "duration_s": 8.22,
    "sha256": "ffec6090de11f70edbc7e12e28f053d5c6ed69e7c47531d2822f2906b3899cb3"
  },
  {
    "id": "vo-003-nestor",
    "step": "home-transcribe",
    "speaker": "nestor",
    "text": "« Enregistrer et transcrire » : vous parlez, ou vous enregistrez une réunion, et le texte s'écrit tout seul.",
    "voice": "nestor-aventuriere",
    "language": "fr",
    "speed": 1.0,
    "path": ".media/audio/voice/vo-003-nestor.wav",
    "duration_s": 6.05,
    "sha256": "6c45af5a066fa7afb1ea787f67ff54f917b78ca3d7f2c766f4a2d2c71e9fa908"
  },
  {
    "id": "vo-004-nestor",
    "step": "home-course",
    "speaker": "nestor",
    "text": "« Cours » : de petites leçons et des exercices pour apprendre à bien demander, à votre rythme.",
    "voice": "nestor-aventuriere",
    "language": "fr",
    "speed": 1.0,
    "path": ".media/audio/voice/vo-004-nestor.wav",
    "duration_s": 5.18,
    "sha256": "4573358e3784b181837f6a1d2eb86f58223b16f58b26f2edc06bff2109f59b9c"
  },
  {
    "id": "vo-005-nestor",
    "step": "home-tools",
    "speaker": "nestor",
    "text": "« Outils du quotidien » : des modèles prêts à l'emploi pour un courriel, un compte rendu, une synthèse.",
    "voice": "nestor-aventuriere",
    "language": "fr",
    "speed": 1.0,
    "path": ".media/audio/voice/vo-005-nestor.wav",
    "duration_s": 5.67,
    "sha256": "7f48e1727935bccb8258517764ac472f4cfff3def9e7a106d648b5db76b3874e"
  },
  {
    "id": "vo-006-nestor",
    "step": "open-coach",
    "speaker": "nestor",
    "text": "Commençons par le plus utile. Cliquez sur la carte « Coach », qui clignote à droite.",
    "voice": "nestor-aventuriere",
    "language": "fr",
    "speed": 1.0,
    "path": ".media/audio/voice/vo-006-nestor.wav",
    "duration_s": 4.66,
    "sha256": "bed15b6b385eb05ac8d13a252f816dda0d5742994dc335fc6545650e22daa5e2"
  },
  {
    "id": "vo-007-nestor",
    "step": "coach-bar",
    "speaker": "nestor",
    "text": "Voici mes quatre boutons. Ils sont toujours là, en bas, au même endroit.",
    "voice": "nestor-aventuriere",
    "language": "fr",
    "speed": 1.0,
    "path": ".media/audio/voice/vo-007-nestor.wav",
    "duration_s": 4.12,
    "sha256": "fbf73602b5165062ac870dc38178aff03e5af90305eff930de9ded62664e164d"
  },
  {
    "id": "vo-008-nestor",
    "step": "coach-analyse",
    "speaker": "nestor",
    "text": "« Analyser mon texte » : je lis votre demande et je vous dis ce qu'elle contient déjà et ce qui manque.",
    "voice": "nestor-aventuriere",
    "language": "fr",
    "speed": 1.0,
    "path": ".media/audio/voice/vo-008-nestor.wav",
    "duration_s": 5.62,
    "sha256": "e60ce8add0833637835bc22511c30ef1e9d029556d2d9ae63286600daf42e020"
  },
  {
    "id": "vo-009-nestor",
    "step": "coach-improve",
    "speaker": "nestor",
    "text": "« Améliorer mon texte » : je vous donne d'abord des conseils, puis je vous propose un meilleur texte.",
    "voice": "nestor-aventuriere",
    "language": "fr",
    "speed": 1.0,
    "path": ".media/audio/voice/vo-009-nestor.wav",
    "duration_s": 5.64,
    "sha256": "d7b1a23f5206020286fd0ab80a2ed6de55a4e47ed3548e16560c868f978ed48a"
  },
  {
    "id": "vo-010-nestor",
    "step": "coach-review",
    "speaker": "nestor",
    "text": "« Faire le bilan » : après la réponse de l'assistant, nous regardons ensemble ce qui a bien marché.",
    "voice": "nestor-aventuriere",
    "language": "fr",
    "speed": 1.0,
    "path": ".media/audio/voice/vo-010-nestor.wav",
    "duration_s": 5.52,
    "sha256": "f6973f924156429ab553c512d27d7cfb717f3c98b00d74e60c37e4e7a871bcfb"
  },
  {
    "id": "vo-011-nestor",
    "step": "coach-ask",
    "speaker": "nestor",
    "text": "« Demander à Nestor » : vous me posez une question, à voix haute ou par écrit.",
    "voice": "nestor-aventuriere",
    "language": "fr",
    "speed": 1.0,
    "path": ".media/audio/voice/vo-011-nestor.wav",
    "duration_s": 4.28,
    "sha256": "b226d2d1c771d32183bfd6a3d8eb3094821ebcceb337b90e17ea1b1778b4451e"
  },
  {
    "id": "vo-012-nestor",
    "step": "field",
    "speaker": "nestor",
    "text": "J'ai mis une demande d'exemple de votre métier dans le champ de l'assistant, au centre. C'est là que vous écrivez d'habitude.",
    "voice": "nestor-aventuriere",
    "language": "fr",
    "speed": 1.0,
    "path": ".media/audio/voice/vo-012-nestor.wav",
    "duration_s": 6.89,
    "sha256": "c9a14c9817c2cf76435b89fbc3625454fb59520724dfad39515e8470e56cdad1"
  },
  {
    "id": "vo-013-nestor",
    "step": "try-analyse",
    "speaker": "nestor",
    "text": "Essayons. Cliquez sur « Analyser mon texte », qui clignote.",
    "voice": "nestor-aventuriere",
    "language": "fr",
    "speed": 1.0,
    "path": ".media/audio/voice/vo-013-nestor.wav",
    "duration_s": 3.39,
    "sha256": "f76cfeb229992442c2c62f0bf4c066bfff9fe8fa5df200fba41f3cbea87c95f2"
  },
  {
    "id": "vo-014-nestor",
    "step": "after-analyse",
    "speaker": "nestor",
    "text": "Voilà : ce que votre demande dit déjà, et ce qui manque. Les boutons sous ma réponse vous aident à la compléter. C'est comme ça qu'on apprend ce que contient une bonne demande.",
    "voice": "nestor-aventuriere",
    "language": "fr",
    "speed": 1.0,
    "path": ".media/audio/voice/vo-014-nestor.wav",
    "duration_s": 9.78,
    "sha256": "174217c9d97837b5a3ea2f65464dca1647768d2eba8c3b490df7c86bffad1991"
  },
  {
    "id": "vo-015-nestor",
    "step": "try-improve",
    "speaker": "nestor",
    "text": "Maintenant, cliquez sur « Améliorer mon texte ».",
    "voice": "nestor-aventuriere",
    "language": "fr",
    "speed": 1.0,
    "path": ".media/audio/voice/vo-015-nestor.wav",
    "duration_s": 2.84,
    "sha256": "66e455fb10cabad3459f22568a73c75c4a4b9227f74fa3a2c9bc6b7202e93a97"
  },
  {
    "id": "vo-016-nestor",
    "step": "after-improve",
    "speaker": "nestor",
    "text": "Pour chaque conseil, vous choisissez : « Ajouter », « Ignorer » ou « Je le fais déjà ». C'est vous qui décidez. Ensuite, je vous montre le meilleur texte.",
    "voice": "nestor-aventuriere",
    "language": "fr",
    "speed": 1.0,
    "path": ".media/audio/voice/vo-016-nestor.wav",
    "duration_s": 8.27,
    "sha256": "1950f245932f69cae6efa2b3b58d9df53618c180038222e04fd69e772a890a3a"
  },
  {
    "id": "vo-017-nestor",
    "step": "end",
    "speaker": "nestor",
    "text": "C'est tout ! Pour revoir cette visite, cliquez sur le point d'interrogation, en haut. À vous de jouer.",
    "voice": "nestor-aventuriere",
    "language": "fr",
    "speed": 1.0,
    "path": ".media/audio/voice/vo-017-nestor.wav",
    "duration_s": 5.72,
    "sha256": "2db711b82b3db2c970cdf555e3ed184ba3c4ebe9a268bf0aff69024ab72b16bb"
  }
]