[
  {
    "id": "vo-001-nestor",
    "step": "hello",
    "speaker": "nestor",
    "text": "Bonjour ! Je suis Nestor, votre coach. En quelques minutes, je vous montre comment je vous aide à bien écrire à l’Assistant. Tout se passe ici, dans le panneau de droite.",
    "voice": "coach-bienveillante",
    "language": "fr",
    "speed": 1.0,
    "path": ".media/audio/voice/vo-001-nestor.wav",
    "duration_s": 9.87,
